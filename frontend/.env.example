# Copy to .env.local for local development. Never commit real values.
# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "on" once Web Analytics + Speed Insights are enabled in the Vercel dashboard.
VERCEL_ANALYTICS=off

# Added when Supabase is connected:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=   # server-only, never exposed to the browser
