# Copy to .env.local for local development. Never commit real values.

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "on" once Web Analytics + Speed Insights are enabled in the Vercel dashboard.
VERCEL_ANALYTICS=off

# --- Supabase (accounts, staff login, live stock, form submissions) -----------
# Without these the site still works: the shop shows the stock file, the forms
# say they are not available yet, and the staff hub stays locked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security: never prefix with NEXT_PUBLIC_,
# never commit it. (SUPABASE_URL may be set instead of the public URL for
# server code; SUPABASE_SECRET_KEY is accepted as an alias.)
SUPABASE_SERVICE_ROLE_KEY=

# --- Local development and browser tests only ---------------------------------
# Opens /hub without a staff login. NEVER set this on a deployed site.
# INSECURE_OPEN_HUB=true

# --- Business details (shown in the footer, contact and legal pages) ----------
# Leave blank until confirmed; blank values are hidden, not shown as placeholders.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_SUPPORT_EMAIL=
# International format, digits only, e.g. 919876543210
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SUPPORT_PHONE=
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_HUB_ADDRESS=
# Required under India's IT Rules 2021 and the DPDP Act 2023 (both fields).
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=
